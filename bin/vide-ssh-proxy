#!/usr/bin/env bash
set -euo pipefail

: "${REMOTE_HOST:?set REMOTE_HOST}"
: "${REMOTE_DIR:?set REMOTE_DIR}"
: "${LOCAL_MOUNT:?set LOCAL_MOUNT}"

exec ssh -- "$REMOTE_HOST" "vide-watch $(printf '%q' "$REMOTE_DIR")" | \
  python3 -c '
import sys
remote, local = sys.argv[1].encode(), sys.argv[2].encode()
buf = bytearray()
for chunk in iter(lambda: sys.stdin.buffer.read(65536), b""):
    buf.extend(chunk)
    while True:
        if not buf: break
        if buf[:1] != b"P":
            if buf: del buf[:1]
            continue
        sep = buf.find(b":")
        if sep < 2: break
        header = bytes(buf[1:sep])
        i = 0
        while i < len(header) and (header[i:i+1].isalpha() or header[i:i+1] == b"_"): i += 1
        if i == 0 or not header[i:].isdigit(): del buf[:1]; continue
        n = int(header[i:]); end = sep + 1 + n
        if len(buf) < end: break
        kind = header[:i]
        path = bytes(buf[sep+1:end])
        if path.startswith(remote): path = local + path[len(remote):]
        out = b"P" + kind + str(len(path)).encode() + b":" + path
        sys.stdout.buffer.write(out); sys.stdout.buffer.flush()
        del buf[:end]
' "$REMOTE_DIR" "$LOCAL_MOUNT"
